<%= component "containers/form" do %>
  <%= component "atoms/sub_header", content: "Sign up" %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col space-y-4 max-w-sm mx-auto" }) do |form| %>
    <%= component "organisms/email_field", form:, name: :email, autofocus: true, required: true %>
    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div>
        Currently waiting confirmation for: <%= resource.unconfirmed_email %>
      </div>
    <% end %>
    <%= component "molecules/input", form:, name: :first_name, autocomplete: "given-name", required: true %>
    <%= component "molecules/input", form:, name: :last_name, autocomplete: "family-name", required: true %>
    <%= component "organisms/password_field", form:, name: :password do |component| %>
      <%= component.with_helper_text do %>
        <% if @minimum_password_length %>
          <em>
            <%= @minimum_password_length %> characters minimum
          </em>
        <% end %>
      <% end %>
    <% end %>
    <%= component "organisms/password_field", form:, name: :password_confirmation, label_text: "Confirm new password", autocomplete: "new-password" %>
    <%= component "atoms/button", title: "Update", type: "submit" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>