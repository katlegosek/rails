<%= component "containers/form" do %>
  <%= component "atoms/sub_header", content: "Welcome back! Please log in to your account." %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col space-y-4 max-w-sm mx-auto" }) do |form| %>
    <%= component "organisms/email_field", form:, name: :email, autofocus: true %>
    <%= component "organisms/password_field", form:, name: :password %>
    <div class="flex flex-col md:flex-row md:items-center justify-start md:justify-between space-y-4 md:space-y-0">
      <%= component "molecules/checkbox", form:, name: :remember_me %>
      <%= component "atoms/button", title: "Forgot your password?", as: :link_to, path: new_password_path(resource_name), variant: :link %>
    </div>
    <%= component "atoms/button", title: "Log in", type: "submit" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
