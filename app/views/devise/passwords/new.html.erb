<%= component "containers/form" do %>
  <%= component "atoms/sub_header", content: "Forgot your password?" %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { class: "flex flex-col space-y-4 max-w-sm mx-auto" }) do |form| %>
    <%= component "organisms/email_field", form:, name: :email, autofocus: true, required: true %>
    <%= component "atoms/button", title: "Send me reset password instructions", type: "submit" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>