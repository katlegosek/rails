<%= component "containers/page" do %>
  <%= component "atoms/breadcrumbs" %>
  <%= component "atoms/page_header", title: "Notification" %>
  <%= component "atoms/tabs", active_tab: params[:tab] || "content" do |component| %>
    <%= component.with_tab(name: "content") do %>
      <%= render "content" %>
    <% end %>
    <%= component.with_tab(name: "users") do %>
      <%= render "users" %>
    <% end %>
  <% end %>
<% end %>