<aside id="drawer-navigation" tabindex="-1" aria-label="Sidenav" class="fixed top-0 left-0 z-40 w-64 h-screen pt-14 transition-transform -translate-x-full bg-primary border-r border-gray-200 md:translate-x-0 dark:bg-gray-800 dark:border-gray-700">
  <div class="overflow-y-auto py-5 px-3 h-full bg-primary dark:bg-gray-800">
    <ul class="space-y-2">
      <%= component "molecules/drawer_item", name: "Dashboard", icon: "dashboard", href: root_path %>
      <%= component "molecules/drawer_item", name: "My Inbox", icon: "my-inbox", badge: current_user.unread_notifications_count, badge_id: "notifications-count", href: inbox_messages_path %>
      <%= component "molecules/drawer_item", name: "Users", icon: "users", href: users_path %>
      <%= component "molecules/drawer_item", name: "Notifications", icon: "inbox", href: notifications_path %>
    </ul>
  </div>
</aside>